# Ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Модель Gemini (можно gemini-2.0-flash, gemini-1.5-flash и др.)
GEMINI_MODEL=gemini-3.8-flash

# Порт backend API
PORT=3001

# Фронтенд: true — только моки без API
# VITE_USE_MOCK=false

# Фронтенд: при ошибке API использовать мок (по умолчанию включено)
# VITE_FALLBACK_MOCK=false
